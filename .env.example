# ═══════════════════════════════════════════════════
# STORM API — Environment Variables
# ═══════════════════════════════════════════════════
# Скопируйте в .env и заполните реальными ключами:
#   cp .env.example .env

# ── LLM Provider ──
STORM_LLM_PROVIDER=openai
# litellm-формат: openai/gpt-4o, anthropic/claude-3-5-sonnet-20241022, etc.
STORM_MODEL_NAME=openai/gpt-4o
STORM_TEMPERATURE=1.0
STORM_MAX_TOKENS=500

# ── API Keys (минимум один LLM + один Search) ──
# OpenAI / Azure OpenAI
OPENAI_API_KEY=sk-...
# OPENAI_API_TYPE=openai
# OPENAI_API_BASE=https://api.openai.com/v1

# ── Ollama (локальная модель, полностью offline) ──
# 1. Запустите Ollama: ollama pull qwen3.6:35b && ollama serve
# 2. Укажите:
#    OPENAI_API_BASE=http://host.docker.internal:11434/v1
#    STORM_MODEL_NAME=qwen3.6:35b
#    OPENAI_API_KEY=ollama   (dummy — Ollama не проверяет ключи)
#    STORM_SEARCH_ENGINE=duckduckgo  (тоже без API key)

# ── Search Engine ──
# you | bing | brave | serper | duckduckgo | tavily | searxng
# duckduckgo — не требует API key (хороше для тестов)
STORM_SEARCH_ENGINE=duckduckgo
STORM_SEARCH_TOP_K=3

# API keys для поиска (нужен тот, что соответствует SEARCH_ENGINE)
# YDC_API_KEY=           # you.com
# BING_SEARCH_API_KEY=   # Bing
# BRAVE_API_KEY=         # Brave Search
# SERPER_API_KEY=        # Serper
# TAVILY_API_KEY=        # Tavily

# SearXNG (только при STORM_SEARCH_ENGINE=searxng + docker compose --profile offline)
# STORM_SEARXNG_URL=http://searxng:8080

# ── Runner ──
STORM_DO_POLISH=true
STORM_MAX_CONV_STEPS=3
STORM_MAX_WORKERS=2
STORM_JOB_TIMEOUT=1800

# ── API Server ──
STORM_API_PORT=8000

# ── Logging ──
# PYTHONDONTWRITEBYTECODE=1
# PYTHONUNBUFFERED=1
